# ========================
# Guardian-AI Root Gitignore
# ========================

# ----- OS Files -----
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- IDEs & Editors -----
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# ----- Node / Frontend -----
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ----- Python / Backend -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/

# ----- Environment Variables -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ----- Database Files -----
*.db
*.sqlite
*.sqlite3

# ----- Secrets & Keys -----
*.pem
*.key
*.cert
*.crt
secrets/

# ----- Misc -----
*.bak
*.tmp
*.temp
*.orig
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
